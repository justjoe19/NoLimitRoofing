---
// Static row of confirmed manufacturer badges — deliberately not a
// scrolling marquee (see CHANGELOG). Each row spans the full container width
// with space-between, and badge size + row gap scale smoothly with the
// viewport (see .cert-row img / .cert-rows in global.css) rather than
// wrapping or shrinking only when a row runs out of room.
const certainteed = { src: "/images/badge-certainteed-shinglemaster-2.webp", alt: "CertainTeed Shingle Master", width: 168, height: 168 };
// Only CertainTeed is confirmed (Joe, 2026-10-14). Other manufacturer badge images are still in
// public/images (GAF, IKO, Owens Corning, Malarkey, Atlas, SRS); add one back only once the client confirms it.
const rows = [[certainteed]];
---

<div class="cert-rows">
  {rows.map((row) => (
    <div class="cert-row" style="justify-content:center;gap:clamp(1.5rem,6vw,4rem)">
      {row.map((b) => (
        <img src={b.src} alt={b.alt} width={b.width} height={b.height} loading="lazy" style="height:clamp(120px,40vw,168px);width:auto" />
      ))}
    </div>
  ))}
</div>
