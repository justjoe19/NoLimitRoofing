---
// Navigation header for live launch pages (Home, Storm Damage, Roof Replacement).
interface Props {
  ctaLabel?: string;
}

const { ctaLabel } = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "" || currentPath === "/index.html";
const isStormDamage = currentPath.includes("storm-damage");
const isRoofReplacement = currentPath.includes("roof-replacement");

const homeHref = "/";
const stormDamageHref = "/storm-damage.html";
const roofReplacementHref = "/roof-replacement.html";

const defaultButtonLabel = isRoofReplacement ? "Free Estimate" : "Free Inspection";
const buttonLabel = ctaLabel || defaultButtonLabel;

const buttonHref = (isHome || isStormDamage || isRoofReplacement)
  ? "#inspection"
  : "/storm-damage.html#inspection";
---

<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/" aria-label="No Limit Roofing home">
      <img src="/images/nlr-logo.webp" alt="No Limit Roofing logo" width="180" height="99" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul>
        {isStormDamage ? (
          <>
            <li><a href={homeHref}>Home</a></li>
            <li><a href={roofReplacementHref}>Roof Replacement</a></li>
          </>
        ) : isRoofReplacement ? (
          <>
            <li><a href={homeHref}>Home</a></li>
            <li><a href={stormDamageHref}>Storm Damage</a></li>
          </>
        ) : (
          <>
            <li><a href={stormDamageHref}>Storm Damage</a></li>
            <li><a href={roofReplacementHref}>Roof Replacement</a></li>
          </>
        )}
        <li><a href="tel:+15743600525" class="nav-phone">(574) 360-0525</a></li>
      </ul>
      <div class="header-cta">
        <a class="btn btn-primary" href={buttonHref}>{buttonLabel}</a>
      </div>
    </nav>
  </div>
</header>
