---
// Only the homepage and the two ad landing pages are live (client decision,
// Oct 2026). The old services/areas/learning-center nav lives in git history.
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href;
const inspectionHref = "/storm-damage-inspection.html";
const estimateHref = "/new-roof-estimate.html";
---

<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/">
      <img src="/images/nlr-logo.webp" alt="No Limit Roofing logo" width="180" height="99" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul>
        <li><a href={inspectionHref} aria-current={isActive(inspectionHref) ? "page" : undefined}>Storm Damage</a></li>
        <li><a href={estimateHref} aria-current={isActive(estimateHref) ? "page" : undefined}>New Roof Estimate</a></li>
        <li><a href="tel:+15743600525" class="nav-phone">(574) 360-0525</a></li>
      </ul>
      <div class="header-cta">
        <a class="btn btn-primary" href="/storm-damage-inspection.html#inspection">Free Inspection</a>
      </div>
    </nav>
  </div>
</header>
