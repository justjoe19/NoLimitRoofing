---
// Navigation header for the live launch pages (Home, Storm Damage, Roof Replacement, Asphalt Shingle Roofing).
interface Props {
  ctaLabel?: string;
}

const { ctaLabel } = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "" || currentPath === "/index.html";
const isStormDamage = currentPath.includes("storm-damage");
const isRoofReplacement = currentPath.includes("roof-replacement");
const isShingles = currentPath.includes("asphalt-shingle-roofing");

// Every page links to every launch page; the current one is marked.
const links = [
  { label: "Home", href: "/", current: isHome },
  { label: "Storm Damage", href: "/storm-damage.html", current: isStormDamage },
  { label: "Roof Replacement", href: "/roof-replacement.html", current: isRoofReplacement },
  { label: "Asphalt Shingles", href: "/asphalt-shingle-roofing.html", current: isShingles },
];

const defaultButtonLabel = (isRoofReplacement || isShingles) ? "Free Estimate" : "Free Inspection";
const buttonLabel = ctaLabel || defaultButtonLabel;

const buttonHref = (isHome || isStormDamage || isRoofReplacement || isShingles)
  ? "#inspection"
  : "/storm-damage.html#inspection";
---

<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/" aria-label="No Limit Roofing home">
      <img src="/images/nlr-logo-360.webp" alt="No Limit Roofing logo" width="180" height="99" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a></li>
        ))}
        <li><a href="tel:+15743600525" class="nav-phone">(574) 360-0525</a></li>
      </ul>
      <div class="header-cta">
        <a class="btn btn-primary" href={buttonHref}>{buttonLabel}</a>
      </div>
    </nav>
  </div>
</header>
