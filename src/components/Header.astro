---
const serviceGroups = [
  {
    title: "Roofing",
    href: "/roofing.html",
    links: [
      { href: "/roofing/roof-replacement.html", label: "Roof Replacement" },
      { href: "/roofing/roof-repair.html", label: "Roof Repair" },
      { href: "/roofing/emergency-roof-repair.html", label: "Emergency Roof Repair" },
      { href: "/roofing/roof-inspections.html", label: "Roof Inspections" },
      { href: "/roofing/asphalt-shingle-roofing.html", label: "Asphalt Shingle Roofing" },
    ],
  },
  {
    title: "Storm Damage",
    href: "/storm-damage.html",
    links: [
      { href: "/storm-damage/hail-damage.html", label: "Hail Damage" },
      { href: "/storm-damage/wind-damage.html", label: "Wind Damage" },
    ],
  },
  {
    title: "Commercial",
    href: "/commercial.html",
    links: [
      { href: "/commercial/repair.html", label: "Commercial Repair" },
      { href: "/commercial/replacement.html", label: "Commercial Replacement" },
      { href: "/commercial/tpo.html", label: "TPO Roofing" },
      { href: "/commercial/epdm.html", label: "EPDM Roofing" },
      { href: "/commercial/roof-coatings.html", label: "Roof Coatings" },
      { href: "/commercial/maintenance.html", label: "Commercial Maintenance" },
    ],
  },
];
const allServiceLinks = serviceGroups.flatMap((g) => [{ href: g.href, label: g.title }, ...g.links]);

// build.format "file" resolves the homepage's build-time URL to
// "/index.html" rather than "/" — normalize so the Home link still matches.
const currentPath = Astro.url.pathname === "/index.html" ? "/" : Astro.url.pathname;

const isActive = (href: string) => currentPath === href;
const isServicesActive = allServiceLinks.some((l) => currentPath === l.href);
---

<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/" aria-label="No Limit Roofing Home">
      <img src="/images/nlr-logo.webp" alt="No Limit Roofing logo" width="160" height="74" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul>
        <li><a href="/" aria-current={isActive("/") ? "page" : undefined} class="whitespace-nowrap">HOME</a></li>
        <li class="nav-dropdown">
          <details>
            <summary aria-current={isServicesActive ? "page" : undefined} class="whitespace-nowrap">
              SERVICES
            </summary>
            <div class="nav-dropdown-panel nav-dropdown-panel--mega">
              {serviceGroups.map((group) => (
                <div class="nav-dropdown-group">
                  <a href={group.href} class="nav-dropdown-group-title" aria-current={isActive(group.href) ? "page" : undefined}>{group.title}</a>
                  {group.links.map((l) => <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>)}
                </div>
              ))}
              <div class="nav-dropdown-group">
                <span class="nav-dropdown-group-title">Resources</span>
                <a href="/areas.html" aria-current={isActive("/areas.html") ? "page" : undefined}>Service Areas</a>
                <a href="/learning-center.html" aria-current={currentPath.startsWith("/learning-center") ? "page" : undefined}>Learning Center</a>
                <a href="/services.html" aria-current={isActive("/services.html") ? "page" : undefined}>All Services</a>
              </div>
            </div>
          </details>
        </li>

        <li><a href="/storm-damage.html" aria-current={isActive("/storm-damage.html") ? "page" : undefined} class="whitespace-nowrap">INSURANCE CLAIMS</a></li>
        <li><a href="/about.html" aria-current={isActive("/about.html") ? "page" : undefined} class="whitespace-nowrap">ABOUT US</a></li>
        <li><a href="/services.html" aria-current={isActive("/services.html") ? "page" : undefined} class="whitespace-nowrap">PROJECT GALLERY</a></li>
        <li><a href="/contact.html" aria-current={isActive("/contact.html") ? "page" : undefined} class="whitespace-nowrap">CONTACT</a></li>
      </ul>
      <div class="header-cta">
        <a class="btn-header-cta" href="/contact.html">
          GET A FREE INSPECTION
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline-block size-4 ml-1" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>
