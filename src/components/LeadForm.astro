---
/**
 * The lead form card (Netlify form "contact"), shared by the hero of the home page
 * and both ad landing pages. One instance per page: ids are fixed (main.js uses them).
 */
interface Props {
  /** Value of the hidden "source" field, so the client can tell leads apart. */
  source: string;
  ctaLabel: string;
  before: string;
  highlight: string;
  after: string;
  intro: string;
  notesPlaceholder: string;
  /** HTML shown after a successful submit. */
  success: string;
}
const { source, ctaLabel, before, highlight, after, intro, notesPlaceholder, success } = Astro.props;
---

<div class="card p-6 sm:p-7 text-ink">
  <div id="lead-sent" class="lp-sent" tabindex="-1" role="status" hidden>
    <div class="inline-flex items-center justify-center size-12 rounded-full bg-accent/15 text-accent mb-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <p class="text-xl font-black uppercase text-ink">Request received</p>
    <p class="mt-2 text-steel leading-relaxed"><Fragment set:html={success} /></p>
  </div>

  <!-- Same Netlify form + handler as /contact (public/js/main.js); "source" tells ad leads apart. -->
  <form id="lead-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="company-website" data-success-panel="lead-sent">
    <div class="lead-card-head" data-lead-head>
      <h2 id="lp-form-h" class="font-black uppercase text-xl sm:text-2xl leading-[1.1] tracking-tight text-ink">{before.toUpperCase()}<br /><span class="text-accent">{highlight.toUpperCase()}</span> {after.toUpperCase()}</h2>
      <p class="mt-2 text-steel text-sm leading-relaxed">{intro}</p>
    </div>
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" name="source" value={source} />
    <p class="honeypot">
      <label>Don't fill this out if you're human: <input name="company-website" tabindex="-1" autocomplete="off" /></label>
    </p>
    <p class="text-steel text-sm">Fields marked <span class="req text-accent-dark">*</span> are required.</p>

    <div class="form-grid mt-3" style="gap:1rem">
      <div class="field full">
        <label for="name">Full Name <span class="req">*</span></label>
        <input type="text" id="name" name="name" autocomplete="name" required placeholder="First and last name" aria-describedby="name-error" />
        <div class="field-error" id="name-error"></div>
      </div>
      <div class="field full">
        <label for="phone">Phone <span class="req">*</span></label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" required placeholder="(574) 555-0123" aria-describedby="phone-error" />
        <div class="field-error" id="phone-error"></div>
      </div>
      <div class="field full">
        <label for="email">Email Address <span class="req text-accent-dark">*</span> <span class="text-steel text-xs font-normal">(for written estimate &amp; report)</span></label>
        <input type="email" id="email" name="email" autocomplete="email" required placeholder="you@example.com" aria-describedby="email-error" />
        <div class="field-error" id="email-error"></div>
      </div>
      <div class="field full">
        <label for="address">Property Address <span class="text-steel text-xs font-normal">(Optional — helps check roof via satellite)</span></label>
        <input type="text" id="address" name="address" autocomplete="street-address" placeholder="e.g. 123 Main St, Mishawaka, IN" />
      </div>
      <div class="field full">
        <label for="message">Notes</label>
        <textarea id="message" name="message" placeholder={notesPlaceholder}></textarea>
      </div>
    </div>

    <div class="form-status" id="form-status" role="status"></div>
    <button type="submit" class="btn btn-primary btn-block mt-3">{ctaLabel}</button>
    
    <div class="mt-3.5 pt-3 border-t border-slate-200">
      <div class="flex flex-wrap items-center justify-between gap-y-2 gap-x-3 text-xs text-steel font-medium">
        <span class="inline-flex items-center gap-1.5">
          <svg class="size-3.5 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          100% Free &amp; No Obligation
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="size-3.5 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Zero Spam &bull; Data Protected
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="size-3.5 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Response Within 24 Hours
        </span>
      </div>
    </div>

    <p class="mt-2.5 text-steel/80 text-[0.78rem] text-center sm:text-left">By submitting, you agree to be contacted about your request by phone, text or email.</p>
  </form>
</div>

<style>
  .lead-card-head { margin-bottom: 1rem; }
</style>
