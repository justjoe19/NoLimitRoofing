---
/**
 * Closing banner for the inner pages: the same band as the bottom of the home page
 * (heading, call link, four service icons, button, service-area line).
 */
import ServicesRow from "./ServicesRow.astro";
import ServiceArea from "./ServiceArea.astro";
import { contactHref } from "../data/site-pages.mjs";

interface Props {
  before: string;
  highlight: string;
  after?: string;
  intro: string;
  buttonLabel?: string;
  buttonHref?: string;
}
const { before, highlight, after = "", intro, buttonLabel = "Get My Free Estimate", buttonHref = contactHref() } = Astro.props;

const phonePath = "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z";
---

<section class="pre-footer-cta" aria-labelledby="page-cta-h">
  <div class="container split lp-cta-3" style="align-items:center">
    <div>
      <p class="text-xs sm:text-sm font-extrabold uppercase tracking-[0.22em] text-white/80 mb-2">READY TO GET STARTED?</p>
      <h2 id="page-cta-h" class="text-white font-black uppercase text-2xl sm:text-3xl lg:text-4xl leading-[1.1] tracking-tight">{before.toUpperCase()}<br /><span class="text-accent">{highlight.toUpperCase()}</span> {after.toUpperCase()}</h2>
      <p class="mt-4 max-w-[460px] text-[#c7cdd3] leading-relaxed">{intro}</p>
      <a href="tel:+15743600525" class="cta-action-row group mt-6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phonePath} /></svg>
        <span class="font-black uppercase tracking-wider text-[1.05rem]">CALL (574) 360-0525</span>
      </a>
    </div>
    <ServicesRow />
    <div class="flex flex-col gap-4 lg:items-end">
      <a class="btn-hero-primary" href={buttonHref}>{buttonLabel.toUpperCase()}</a>
      <ServiceArea />
    </div>
  </div>
</section>
