---
interface Props { ctaLabel: string }
const { ctaLabel } = Astro.props;
---

<!-- Same bar as the homepage header, minus the nav: logo, phone, one CTA. -->
<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/">
      <img src="/images/nlr-logo.webp" alt="No Limit Roofing logo" width="180" height="99" />
    </a>
    <div class="header-cta">
      <a class="lp-header-phone" href="tel:+15743600525" aria-label="Call (574) 360-0525">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>(574) 360-0525</span>
      </a>
      <a class="btn btn-primary" href="#inspection">{ctaLabel}</a>
    </div>
  </div>
</header>

<style>
  .lp-header-phone { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: .95rem; color: var(--color-accent-light); white-space: nowrap; }
  .lp-header-phone:hover { color: #fff; }
  /* Phones: the sticky call bar covers calling, so keep just the icon and a compact button. */
  @media (max-width: 639px) {
    .lp-header-phone span { display: none; }
    .header-cta { gap: .75rem; }
    .header-cta .btn { padding: .7rem .9rem; font-size: .8rem; }
  }
</style>
