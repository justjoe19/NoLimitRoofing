---
/**
 * Dark band shared by every landing page: copy on the left, six photo tiles on the right
 * (layout from the client's storm-damage mockup; each page passes its own copy).
 *
 * TODO(client photos): a tile with `img: null` renders a placeholder.
 */
interface Tile { label: string; img: string | null; alt: string }
interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  ctaLabel: string;
  tiles: Tile[];
}
const { eyebrow, heading, intro, ctaLabel, tiles } = Astro.props;
---

<section class="section section--ink" aria-labelledby="tiles-h">
  <div class="container grid grid-cols-1 lg:grid-cols-[1fr_1.7fr] gap-8 lg:gap-12 items-center">
    <div>
      <span class="text-xs sm:text-sm font-extrabold uppercase tracking-[0.2em] text-accent">{eyebrow}</span>
      <h2 id="tiles-h" class="text-white text-2xl sm:text-3xl font-black uppercase tracking-tight mt-1">{heading}</h2>
      <div class="w-14 h-1 bg-accent mt-2.5"></div>
      <p class="mt-4 text-[#c7cdd3] leading-relaxed">{intro}</p>
      <a class="btn-hero-primary mt-6" href="#inspection">{ctaLabel.toUpperCase()}</a>
    </div>
    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3 lg:gap-4">
      {tiles.map((t) => (
        <li>
          <div class="tile-img">
            {t.img ? <img src={t.img} alt={t.alt} width="300" height="300" loading="lazy" /> : <div class="tile-ph" role="img" aria-label={t.alt}><span>PHOTO<br />PLACEHOLDER</span></div>}
          </div>
          <p class="mt-2 text-center text-[0.8rem] font-bold text-white">{t.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tile-img { aspect-ratio: 1 / 1; overflow: hidden; border-radius: 3px; background: #1b2229; }
  .tile-img img { width: 100%; height: 100%; object-fit: cover; }
  .tile-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; background: repeating-linear-gradient(135deg, #2b343c 0 12px, #252d34 12px 24px); color: rgba(255,255,255,.45); font-size: .62rem; font-weight: 800; letter-spacing: .14em; line-height: 1.4; }
</style>
