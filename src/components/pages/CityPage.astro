---
/**
 * One city page, built from a file in src/content/locations. Rendered by src/pages/[slug].astro.
 * Links to pages that are not published yet are left out.
 */
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import PageCta from "../PageCta.astro";
import SectionHead from "../SectionHead.astro";
import PageCard from "../PageCard.astro";
import { findEntry, isLive, publishedLinks, isPublishedPath, contactHref, unlinkUnpublishedHtml } from "../../data/site-pages.mjs";

interface Props { entry: CollectionEntry<"locations">; path: string }
const { entry, path } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const bodyHtml = unlinkUnpublishedHtml(entry.rendered?.html ?? "");
const allLocations = await getCollection("locations");

const canonical = `https://nolimitroofingin.com${path}`;
const ogImage = `https://nolimitroofingin.com${d.heroImage.replace("-hero.webp", ".webp")}`;

// Nearby cities that are published.
const nearbyCities = d.nearby.flatMap((slug) => {
  const match = allLocations.find((l) => l.data.slug === slug);
  const page = match && findEntry("city", match.id);
  return match && page && isLive(page) ? [{ data: match.data, path: page.path }] : [];
});
const explore = publishedLinks([
  { label: "Residential Roofing", href: "/residential-roofing.html" },
  { label: "Roof Replacement", href: "/roof-replacement.html" },
  { label: "Roof Repair", href: "/roof-repair.html" },
  { label: "Storm Damage", href: "/storm-damage.html" },
  { label: "Commercial Roofing", href: "/commercial-roofing.html" },
  ...d.guides,
]);
const servicesHere = d.servicesOffered;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "RoofingContractor",
    name: "No Limit Roofing",
    url: "https://nolimitroofingin.com/",
    telephone: "+1-574-360-0525",
    image: "https://nolimitroofingin.com/images/nlr-logo.png",
    description: `Residential and commercial roofing, roof repair, replacement and storm damage repair in ${d.city}, ${d.state}.`,
    areaServed: { "@type": "City", name: d.city, containedInPlace: { "@type": "AdministrativeArea", name: d.county } },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      { "@type": "ListItem", position: 2, name: `Roofing in ${d.city}, ${d.state}`, item: canonical },
    ],
  },
  ...(d.faqs.length
    ? [{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: d.faqs.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
      }]
    : []),
];
---

<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  canonical={canonical}
  ogImage={ogImage}
  preloadImage={d.heroImage}
  schema={schema}
>
  <PageHero image={d.heroImage} eyebrow={d.heroEyebrow} title={d.heroHeadline} lede={d.heroLede} crumbs={[...(isPublishedPath("/service-areas.html") ? [{ label: "Service Areas", href: "/service-areas.html" }] : []), { label: `Roofing in ${d.city}` }]} />

  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="max-prose article-body">
        <p class="lede">{d.localContext}</p>
        <Fragment set:html={bodyHtml} />
      </div>
      <div class="panel-dark">
        <h2>Services Available In {d.city}</h2>
        <ul class="checklist mt-3">
          {servicesHere.map((s) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{s}</span>
            </li>
          ))}
        </ul>
        <a class="btn-hero-primary mt-6 w-full" href={contactHref()}>GET MY FREE ESTIMATE</a>
      </div>
    </div>
  </section>

  {d.projects.length > 0 && (
    <section class="section section--ink" aria-labelledby="work-heading">
      <div class="container">
        <SectionHead dark eyebrow="Local proof" title={`Recent Work Near ${d.city}`} id="work-heading" />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {d.projects.map((pr) => (
            <PageCard
              img={pr.photos[0]?.src ?? "/images/aerial-completed-roof.webp"}
              alt={pr.photos[0]?.alt ?? pr.title}
              title={pr.title}
              kicker={[pr.year, pr.material].filter(Boolean).join(" · ")}
              body={pr.summary}
              width={600}
              height={440}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {explore.length > 0 && (
    <section class="section section--fog">
      <div class="container">
        <SectionHead center eyebrow="Explore" title={`Roofing Services In ${d.city}`} />
        <div class="chip-row" style="justify-content:center">
          {explore.map((l) => <a class="chip" href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </section>
  )}

  {d.faqs.length > 0 && (
    <section class="section" aria-labelledby="faq-heading">
      <div class="container" style="max-width:820px">
        <SectionHead center eyebrow="FAQ" title={`${d.city} Roofing Questions`} id="faq-heading" />
        <div>
          {d.faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{f.question}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {nearbyCities.length > 0 && (
    <section class="section section--fog section--tight">
      <div class="container">
        <SectionHead center eyebrow="Nearby" title={`Other Areas Near ${d.city}`} />
        <div class="chip-row" style="justify-content:center">
          {nearbyCities.map((c) => <a class="chip" href={c.path}>Roofing in {c.data.city}, {c.data.state}</a>)}
        </div>
      </div>
    </section>
  )}

  <PageCta before={`Ready to get your ${d.city}`} highlight="roof checked?" intro="Free, no-pressure estimates from a CertainTeed factory-certified crew." />
</BaseLayout>
