---
/**
 * One service page (roof repair, hail damage, TPO, ...), built from a file in src/content/services.
 * Rendered by src/pages/[slug].astro. Links to pages that are not published yet are left out.
 */
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import PageCta from "../PageCta.astro";
import SectionHead from "../SectionHead.astro";
import { pages, isLive, publishedLinks, isPublishedPath, contactHref, unlinkUnpublishedHtml } from "../../data/site-pages.mjs";

interface Props { entry: CollectionEntry<"services">; path: string }
const { entry, path } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const bodyHtml = unlinkUnpublishedHtml(entry.rendered?.html ?? "");

const groups = {
  roofing: { href: "/residential-roofing.html", label: "Residential Roofing" },
  "storm-damage": { href: "/storm-damage.html", label: "Storm Damage" },
  commercial: { href: "/commercial-roofing.html", label: "Commercial Roofing" },
} as const;
const group = groups[d.group];
const commercial = d.group === "commercial";
const groupLive = isPublishedPath(group.href);

const canonical = `https://nolimitroofingin.com${path}`;
const ogImage = `https://nolimitroofingin.com${d.heroImage.replace("-hero.webp", ".webp")}`;
const related = publishedLinks(d.relatedLinks);
const cityLinks = pages.filter((p) => p.kind === "city" && isLive(p));
const crumbs = groupLive ? [{ label: group.label, href: group.href }, { label: d.title }] : [{ label: d.title }];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      ...(groupLive ? [{ "@type": "ListItem", position: 2, name: group.label, item: `https://nolimitroofingin.com${group.href}` }] : []),
      { "@type": "ListItem", position: groupLive ? 3 : 2, name: d.title, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: d.title,
    provider: { "@type": "RoofingContractor", name: "No Limit Roofing", telephone: "+1-574-360-0525" },
    areaServed: [
      { "@type": "AdministrativeArea", name: "St. Joseph County, IN" },
      { "@type": "AdministrativeArea", name: "LaPorte County, IN" },
      { "@type": "AdministrativeArea", name: "Marshall County, IN" },
      { "@type": "AdministrativeArea", name: "Berrien County, MI" },
      { "@type": "AdministrativeArea", name: "Cass County, MI" },
    ],
  },
  ...(d.faqs.length
    ? [{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: d.faqs.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
      }]
    : []),
];
---

<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  canonical={canonical}
  ogImage={ogImage}
  preloadImage={d.heroImage}
  schema={schema}
>
  <PageHero
    image={d.heroImage}
    eyebrow={d.heroEyebrow}
    title={d.heroHeadline}
    lede={d.heroLede}
    crumbs={crumbs}
    ctas={commercial
      ? [{ label: "Request a Commercial Roof Assessment", href: contactHref(), variant: "primary" }, { label: "Call Now", href: "tel:+15743600525", variant: "outline" }]
      : undefined}
  />

  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="max-prose article-body">
        <Fragment set:html={bodyHtml} />
      </div>
      {d.highlights.length > 0 && (
        <div class="panel-dark">
          <h2>What's Included</h2>
          <ul class="checklist mt-3">
            {d.highlights.map((h) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{h}</span>
              </li>
            ))}
          </ul>
          <a class="btn-hero-primary mt-6 w-full" href={contactHref()}>{commercial ? "REQUEST AN ASSESSMENT" : "GET MY FREE ESTIMATE"}</a>
        </div>
      )}
    </div>
  </section>

  {d.faqs.length > 0 && (
    <section class="section section--fog" aria-labelledby="faq-heading">
      <div class="container" style="max-width:820px">
        <SectionHead center eyebrow="FAQ" title="Common Questions" id="faq-heading" />
        <div>
          {d.faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{f.question}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead center eyebrow="Related" title="You Might Also Need" />
        <div class="chip-row" style="justify-content:center">
          {related.map((link) => <a class="chip" href={link.href}>{link.label}</a>)}
        </div>
      </div>
    </section>
  )}

  {cityLinks.length > 0 && (
    <section class="section section--fog section--tight">
      <div class="container">
        <SectionHead center eyebrow="Service areas" title={`Where We Provide ${d.title}`} />
        <div class="chip-row" style="justify-content:center">
          {cityLinks.map((c) => <a class="chip" href={c.path}>{c.title}</a>)}
        </div>
      </div>
    </section>
  )}

  {commercial ? (
    <PageCta before="Ready for a commercial" highlight="roof assessment?" intro="Free inspection and written estimate, planned around your business." buttonLabel="Request an Assessment" />
  ) : (
    <PageCta before="Ready to talk about" highlight="your roof?" intro="Free, no-pressure estimates from a CertainTeed factory-certified crew." />
  )}
</BaseLayout>
