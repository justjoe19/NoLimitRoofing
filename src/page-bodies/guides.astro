---
/**
 * Guides listing (a free listing page, not one of the 65): every published guide, grouped by topic.
 * Keeps the Guides menu short. Guides that are not published yet are left out.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageCta from "../components/PageCta.astro";
import PageCard from "../components/PageCard.astro";
import SectionHead from "../components/SectionHead.astro";
import { findEntry, guideGroups, isLive, pages } from "../data/site-pages.mjs";

const heroImage = "/images/guides-hub-hero.webp";
const articles = await getCollection("learningCenter", ({ data }) => !data.draft);

const groups = guideGroups
  .map((g, i) => ({
    ...g,
    id: `guides-${i}`,
    cards: g.slugs
      .map((slug) => pages.find((p) => p.kind === "guide" && p.path === `/guides/${slug}.html`))
      .filter((p) => p && isLive(p) && p.id)
      .map((p) => {
        const a = articles.find((x) => x.id === p!.id);
        return a && { path: p!.path, img: a.data.heroImage.replace("-hero.webp", ".webp"), title: p!.title, body: a.data.excerpt };
      })
      .filter(Boolean) as { path: string; img: string; title: string; body: string }[],
  }))
  .filter((g) => g.cards.length > 0);

const canonical = "https://nolimitroofingin.com/guides.html";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: canonical },
    ],
  },
];
---

<BaseLayout
  title="Roofing Guides for Michiana Homeowners | No Limit Roofing"
  description="Plain-language roofing guides: what a roof costs, repair or replace, storm damage, estimates and roof systems, for homeowners and building owners in Michiana."
  canonical={canonical}
  ogImage="https://nolimitroofingin.com/images/guides-hub.webp"
  preloadImage={heroImage}
  schema={schema}
>
  <PageHero
    image={heroImage}
    eyebrow="Roofing Guides"
    title="Straight Answers Before You Buy"
    lede="Plain-language guides on cost, repair or replacement, storm damage, estimates and roof systems, written for Michiana property owners."
    crumbs={[{ label: "Guides" }]}
  />

  {groups.map((g, i) => (
    <section class:list={["section", { "section--fog": i % 2 === 1 }]} aria-labelledby={`${g.id}-heading`}>
      <div class="container">
        <SectionHead title={g.title} id={`${g.id}-heading`} />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {g.cards.map((c) => (
            <PageCard img={c.img} alt={c.title} title={c.title} body={c.body} href={c.path} width={600} height={440} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <PageCta before="Still have" highlight="a question?" intro="Call or send a request and we'll answer it, with a free inspection if you want one." />
</BaseLayout>
