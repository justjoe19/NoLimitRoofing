---
/**
 * Our Process (page 48 of the 65-page plan). Describes only what the live pages already promise:
 * a free inspection, documentation, honest options, a written estimate, professional installation,
 * cleanup and a walkthrough. The client confirms the deliverables before this page goes live.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageCta from "../components/PageCta.astro";
import SectionHead from "../components/SectionHead.astro";
import { isPublishedPath } from "../data/site-pages.mjs";

const heroImage = "/images/crew-shingle-install-hero.webp";

const inspect = [
  { t: "Inspect it", b: "A professional looks at your roof's condition, at no cost to you." },
  { t: "Document it", b: "We record what we find so you can see it too, not just take our word for it." },
  { t: "Explain it", b: "We walk you through the findings in plain language, including whether repair or replacement makes sense." },
  { t: "You decide", b: "You get clear options and a written estimate, with no pressure and no obligation." },
];
const install = [
  { t: "Roof Evaluation", b: "A professional look at your roof's condition, at no cost." },
  { t: "Clear Options", b: "Straightforward choices for repair or full replacement." },
  { t: "Detailed Estimate", b: "A written estimate with no pressure and no obligation." },
  { t: "Installation", b: "Professional install with a clean, organized job site." },
  { t: "Cleanup & Walkthrough", b: "We clean up and walk through the finished roof with you." },
];
const faqs = [
  { q: "Is the inspection really free?", a: "Yes. The inspection and the written estimate are free, with no obligation to hire us." },
  { q: "Will I get anything in writing?", a: "Yes. You receive a written estimate, so you can compare it and take your time deciding." },
  { q: "Do I have to replace the whole roof?", a: "Not necessarily. We explain whether a repair or a full replacement makes sense, and we tell you honestly if a repair won't hold." },
  { q: "What if the damage came from a storm?", a: "Storm damage is handled a little differently, because it often involves an insurance claim. Our storm damage page explains how we help with that." },
];

const canonical = "https://nolimitroofingin.com/our-process.html";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      { "@type": "ListItem", position: 2, name: "Our Process", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<BaseLayout
  title="Our Roofing Process: Inspect, Document, Explain | No Limit Roofing"
  description="How a No Limit Roofing project works: a free inspection, clear documentation, honest options, a written estimate, installation and a final walkthrough."
  canonical={canonical}
  ogImage="https://nolimitroofingin.com/images/crew-shingle-install.webp"
  preloadImage={heroImage}
  schema={schema}
>
  <PageHero
    image={heroImage}
    eyebrow="Our Process"
    title="Inspect It. Document It. Explain It. You Decide."
    lede="No surprises, from the first look to the final cleanup. Here is what to expect when you work with No Limit Roofing."
    crumbs={[{ label: "Our Process" }]}
  />

  <section class="section section--ink" aria-labelledby="inspection-heading">
    <div class="container">
      <SectionHead dark eyebrow="The inspection" title="Start With A Free Roof Inspection" id="inspection-heading" intro="Every project begins with an honest look at your roof, before anyone talks about replacing anything." />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        {inspect.map((st, i) => (
          <div class="tile-dark">
            <div class="tile-n">{String(i + 1).padStart(2, "0")}</div>
            <h3>{st.t}</h3>
            <p>{st.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="project-heading">
    <div class="container">
      <SectionHead eyebrow="The project" title="Simple Process. Straight Answers." id="project-heading" intro="From the first evaluation to the finished roof." />
      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
        {install.map((st, i) => (
          <li class="tile-dark">
            <div class="tile-n">{String(i + 1).padStart(2, "0")}</div>
            <h3>{st.t}</h3>
            <p>{st.b}</p>
          </li>
        ))}
      </ol>
      {isPublishedPath("/storm-damage.html") && (
        <p class="mt-8 text-[#4a5568] leading-relaxed max-w-[720px]">
          Dealing with storm damage? The steps are similar, with added help for your insurance claim. See our <a class="font-bold text-accent-dark underline underline-offset-2" href="/storm-damage.html">storm damage page</a>.
        </p>
      )}
    </div>
  </section>

  <section class="section section--fog" aria-labelledby="faq-heading">
    <div class="container" style="max-width:820px">
      <SectionHead center eyebrow="FAQ" title="Common Questions" id="faq-heading" />
      <div>
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <PageCta before="Ready for your" highlight="free inspection?" intro="No cost, no obligation. We'll inspect your roof, document it and walk you through every option honestly." />
</BaseLayout>
