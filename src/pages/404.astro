---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Page Not Found | No Limit Roofing</title>
<meta name="robots" content="noindex" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
</head>
<body>
<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/">
      <img src="/images/nlr-logo-360.webp" alt="No Limit Roofing logo" width="180" height="99" />
    </a>
  </div>
</header>
<main id="main">
  <section class="section text-center">
    <div class="container">
      <p class="eyebrow" style="justify-content:center">404</p>
      <h1 class="mt-2">We Couldn't Find That Page</h1>
      <p class="lede mt-2">The page you're looking for may have moved or no longer exists. Head back home, or call us and we'll help you directly.</p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn btn-primary" href="/">Back To Home</a>
        <a class="btn btn-outline-dark" href="/storm-damage.html#inspection">Free Inspection</a>
        <a class="btn btn-outline-dark" href="tel:+15743600525">Call (574) 360-0525</a>
      </div>
    </div>
  </section>
</main>
<footer class="site-footer">
  <div class="container footer-bottom">
    <span>&copy; <span id="year">{new Date().getFullYear()}</span> No Limit Roofing. All rights reserved.</span>
    <span>Website by <a href="https://michiana.dev" target="_blank" rel="noopener" class="font-bold text-white hover:text-accent-light">Michiana.dev</a></span>
  </div>
</footer>
<script is:inline>document.getElementById("year").textContent = new Date().getFullYear();</script>
</body>
</html>
