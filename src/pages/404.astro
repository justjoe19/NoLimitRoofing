---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Page Not Found | No Limit Roofing</title>
<meta name="robots" content="noindex" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
</head>
<body>
<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/">
      <img src="/images/nlr-logo.webp" alt="No Limit Roofing logo" width="150" height="70" />
    </a>
  </div>
</header>
<main id="main">
  <section class="section text-center">
    <div class="container">
      <p class="eyebrow" style="justify-content:center">404</p>
      <h1 class="mt-2">We Couldn't Find That Page</h1>
      <p class="lede mt-2">The page you're looking for may have moved. Try one of the links below, or head back home.</p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn btn-primary" href="/">Back To Home</a>
        <a class="btn btn-outline-dark" href="/contact.html">Contact Us</a>
      </div>
    </div>
  </section>
</main>
<footer class="site-footer">
  <div class="container footer-bottom">
    <span>&copy; 2026 No Limit Roofing. All rights reserved.</span>
  </div>
</footer>
</body>
</html>
