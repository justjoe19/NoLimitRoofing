---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({
    params: { group: entry.data.group, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const groupInfo = {
  roofing: { href: "/roofing.html", label: "Roofing" },
  "storm-damage": { href: "/storm-damage.html", label: "Storm Damage" },
  commercial: { href: "/commercial.html", label: "Commercial" },
}[d.group];

const canonical = `https://nolimitroofingin.com/${d.group}/${d.slug}.html`;
const ogImage = `https://nolimitroofingin.com${d.heroImage.replace("-hero.webp", ".webp")}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      { "@type": "ListItem", position: 2, name: groupInfo.label, item: `https://nolimitroofingin.com${groupInfo.href}` },
      { "@type": "ListItem", position: 3, name: d.title, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: d.title,
    provider: { "@type": "RoofingContractor", name: "No Limit Roofing", telephone: "+1-574-360-0525" },
    areaServed: [
      { "@type": "AdministrativeArea", name: "St. Joseph County, IN" },
      { "@type": "AdministrativeArea", name: "LaPorte County, IN" },
      { "@type": "AdministrativeArea", name: "Marshall County, IN" },
      { "@type": "AdministrativeArea", name: "Berrien County, MI" },
      { "@type": "AdministrativeArea", name: "Cass County, MI" },
    ],
  },
  ...(d.faqs.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: d.faqs.map((f) => ({
            "@type": "Question",
            name: f.question,
            acceptedAnswer: { "@type": "Answer", text: f.answer },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  canonical={canonical}
  ogImage={ogImage}
  preloadImage={d.heroImage}
  schema={schema}
>

  <section class="hero hero--page" style={`--hero-image:url("${d.heroImage}")`}>
    <div class="container hero-inner wide">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href={groupInfo.href}>{groupInfo.label}</a><span aria-hidden="true">/</span>
        <span class="current">{d.title}</span>
      </nav>
      <p class="eyebrow eyebrow--on-dark mt-3">{d.heroEyebrow}</p>
      <h1>{d.heroHeadline}</h1>
      <p class="lede">{d.heroLede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact.html">Get a Free Estimate</a>
        <a class="btn btn-outline-light" href="tel:+15743600525">Call (574) 360-0525</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="max-prose service-copy">
        <Content />
      </div>
      {d.highlights.length > 0 && (
        <div class="card p-8">
          <h2 class="text-[1.25rem]">What's Included</h2>
          <ul class="checklist mt-3">
            {d.highlights.map((h) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{h}</span>
              </li>
            ))}
          </ul>
          <a class="btn btn-primary btn-block mt-4" href="/contact.html">Get My Free Estimate</a>
        </div>
      )}
    </div>
  </section>

  {d.faqs.length > 0 && (
    <section class="section section--fog" aria-labelledby="faq-heading">
      <div class="container" style="max-width:820px">
        <div class="section-head center">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-heading">Common Questions</h2>
        </div>
        <div>
          {d.faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{f.question}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.relatedLinks.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head center">
          <p class="eyebrow">Related</p>
          <h2>You Might Also Need</h2>
        </div>
        <div class="chip-row" style="justify-content:center">
          {d.relatedLinks.map((link) => (
            <a class="chip" href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Ready To Talk About Your Roof?</h2>
          <p>Free, no-pressure estimates from an owner-supervised, GAF-certified crew.</p>
        </div>
        <div class="hero-actions" style="margin-top:0">
          <a class="btn bg-white text-accent-dark" href="/contact.html">Get My Free Estimate</a>
          <a class="btn btn-outline-light" href="tel:+15743600525">Call (574) 360-0525</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
