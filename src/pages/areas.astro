---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroImage = "/images/laporte-county-hero.webp";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      { "@type": "ListItem", position: 2, name: "Service Areas", item: "https://nolimitroofingin.com/areas.html" },
    ],
  },
];

const counties = [
  {
    name: "St. Joseph County, IN",
    note: "Home to our Mishawaka regional office.",
    cities: ["South Bend", "Mishawaka", "Granger", "Osceola"],
    icon: "compass",
  },
  {
    name: "LaPorte County, IN",
    note: "Residential and commercial roofing coverage.",
    cities: ["LaPorte", "Michigan City", "Westville"],
    icon: "waves",
  },
  {
    name: "Marshall County, IN",
    note: "Home to our Plymouth regional office.",
    cities: ["Plymouth", "Bourbon", "Bremen"],
    icon: "landmark",
  },
  {
    name: "Berrien County, MI",
    note: "Cross-border coverage into southwest Michigan.",
    cities: ["St. Joseph", "Benton Harbor", "Niles", "Buchanan"],
    icon: "sunset",
  },
  {
    name: "Cass County, MI",
    note: "Serving communities across southwest Michigan.",
    cities: ["Cassopolis", "Dowagiac", "Edwardsburg"],
    icon: "tree-pine",
  },
  {
    name: "Greater South Bend–Elkhart Region",
    note: "Regional coverage across the wider Michiana area.",
    cities: ["Elkhart", "Goshen", "Nappanee"],
    icon: "factory",
  },
];
---

<BaseLayout
  title="Service Areas | Roofing Contractor Serving Michiana"
  description="No Limit Roofing serves St. Joseph, LaPorte & Marshall Counties, IN and Berrien & Cass Counties, MI, with regional offices in Mishawaka and Plymouth."
  canonical="https://nolimitroofingin.com/areas.html"
  ogImage="https://nolimitroofingin.com/images/laporte-county-hero.webp"
  ogTitle="Service Areas | No Limit Roofing"
  ogDescription="Serving St. Joseph, LaPorte & Marshall Counties IN and Berrien & Cass Counties MI."
  preloadImage={heroImage}
  schema={schema}
>

  <section class="hero hero--page" style={`--hero-image:url("${heroImage}")`}>
    <div class="container hero-inner wide">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span class="current">Service Areas</span>
      </nav>
      <p class="eyebrow eyebrow--on-dark mt-3">Where We Work</p>
      <h1>Proudly Serving The Michiana Region</h1>
      <p class="lede">Regional offices in Mishawaka and Plymouth, Indiana put a factory-certified crew close to home across five counties — with an Ohio location opening soon.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="counties-heading">
    <div class="container">
      <h2 id="counties-heading" class="visually-hidden">Counties We Serve</h2>
      <div class="grid grid-3">
        {counties.map((county) => (
          <div class="area-card">
            <div class="icon-tile" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {county.icon === "compass" && (
                  <Fragment>
                    <circle cx="12" cy="12" r="10" />
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
                  </Fragment>
                )}
                {county.icon === "waves" && (
                  <Fragment>
                    <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
                    <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
                    <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
                  </Fragment>
                )}
                {county.icon === "landmark" && (
                  <Fragment>
                    <line x1="3" y1="22" x2="21" y2="22" />
                    <line x1="6" y1="18" x2="6" y2="11" />
                    <line x1="10" y1="18" x2="10" y2="11" />
                    <line x1="14" y1="18" x2="14" y2="11" />
                    <line x1="18" y1="18" x2="18" y2="11" />
                    <polygon points="12 2 20 7 4 7" />
                    <line x1="3" y1="7" x2="21" y2="7" />
                  </Fragment>
                )}
                {county.icon === "sunset" && (
                  <Fragment>
                    <path d="M12 10V2" />
                    <path d="m4.93 10.93 1.41 1.41" />
                    <path d="M2 18h2" />
                    <path d="M20 18h2" />
                    <path d="m19.07 10.93-1.41 1.41" />
                    <path d="M22 22H2" />
                    <path d="m16 6-4-4-4 4" />
                    <path d="M16 18a4 4 0 0 0-8 0" />
                  </Fragment>
                )}
                {county.icon === "tree-pine" && (
                  <path d="m12 2-6 7h4l-5 7h7v6h2v-6h7l-5-7h4z" />
                )}
                {county.icon === "factory" && (
                  <Fragment>
                    <path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
                    <path d="M17 18h1" />
                    <path d="M12 18h1" />
                    <path d="M7 18h1" />
                  </Fragment>
                )}
              </svg>
            </div>
            <h3>{county.name}</h3>
            <p class="text-steel">{county.note}</p>
            <ul>
              {county.cities.map((city) => <li>{city}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="priority-cities-heading">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">City Pages</p>
        <h2 id="priority-cities-heading">Priority Service Areas</h2>
        <p class="lede">Detailed, city-specific pages for our core markets — more are added as our project history grows in each area.</p>
      </div>
      <div class="chip-row" style="justify-content:center">
        <a class="chip" href="/service-areas/south-bend.html">South Bend, IN</a>
        <a class="chip" href="/service-areas/mishawaka.html">Mishawaka, IN</a>
        <a class="chip" href="/service-areas/granger.html">Granger, IN</a>
        <a class="chip" href="/service-areas/elkhart.html">Elkhart, IN</a>
        <a class="chip" href="/service-areas/goshen.html">Goshen, IN</a>
        <a class="chip" href="/service-areas/plymouth.html">Plymouth, IN</a>
        <a class="chip" href="/service-areas/niles.html">Niles, MI</a>
        <a class="chip" href="/service-areas/st-joseph.html">St. Joseph, MI</a>
        <a class="chip" href="/service-areas/buchanan.html">Buchanan, MI</a>
        <a class="chip" href="/service-areas/edwardsburg.html">Edwardsburg, MI</a>
      </div>
    </div>
  </section>

  <section class="section section--fog">
    <div class="container split">
      <div>
        <p class="eyebrow">Our Locations</p>
        <h2>Two Regional Offices, One More On The Way</h2>
        <p class="lede mt-2">We keep crews close to the neighborhoods we serve. Give us a call and we'll connect you with the team nearest you.</p>
        <div class="grid grid-cols-2 mt-6">
          <div class="card p-6">
            <h3>Mishawaka, IN</h3>
            <p class="mt-1 text-steel">Regional Office</p>
            <a class="btn btn-outline-dark mt-3" href="tel:+15743600525">Call This Office</a>
          </div>
          <div class="card p-6">
            <h3>Plymouth, IN</h3>
            <p class="mt-1 text-steel">Regional Office</p>
            <a class="btn btn-outline-dark mt-3" href="tel:+15743600525">Call This Office</a>
          </div>
        </div>
        <p class="mt-3 text-steel">A new location is opening soon in Ohio.</p>
      </div>
      <div class="map-frame">
        <iframe src="https://www.google.com/maps?q=Mishawaka,+IN&output=embed" title="Map of No Limit Roofing's Michiana service area" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Don't See Your Area Listed?</h2>
          <p>Give us a call — we may still be able to help outside these counties.</p>
        </div>
        <div class="hero-actions" style="margin-top:0">
          <a class="btn bg-white text-accent-dark" href="/contact.html">Get My Free Estimate</a>
          <a class="btn btn-outline-light" href="tel:+15743600525">Call (574) 360-0525</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
