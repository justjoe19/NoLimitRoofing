---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PageCta from "../../components/PageCta.astro";
import SectionHead from "../../components/SectionHead.astro";
import PageCard from "../../components/PageCard.astro";
import { findEntry, isLive, publishedLinks, isPublishedPath, contactHref, unlinkUnpublishedHtml } from "../../data/site-pages.mjs";

export async function getStaticPaths() {
  const show = (p: any) => isLive(p) || import.meta.env.DEV;
  const out: any[] = [];
  for (const entry of await getCollection("learningCenter", ({ data }) => !data.draft)) {
    const page = findEntry("guide", entry.id);
    if (page && show(page)) out.push({ params: { slug: page.path.replace("/guides/", "").replace(/\.html$/, "") }, props: { entry, path: page.path } });
  }
  return out;
}

const { entry, path } = Astro.props;
const { Content } = await render(entry);
const bodyHtml = unlinkUnpublishedHtml(entry.rendered?.html ?? "");
const d = entry.data;

const canonical = `https://nolimitroofingin.com${path}`;
const related = publishedLinks(d.relatedLinks);
const ogImage = `https://nolimitroofingin.com${d.heroImage.replace("-hero.webp", ".webp")}`;

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      { "@type": "ListItem", position: 2, name: d.title, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: d.title,
    description: d.metaDescription,
    image: ogImage,
    datePublished: d.publishDate.toISOString(),
    dateModified: (d.updatedDate ?? d.publishDate).toISOString(),
    author: { "@type": "Organization", name: "No Limit Roofing" },
    publisher: { "@type": "Organization", name: "No Limit Roofing", logo: { "@type": "ImageObject", url: "https://nolimitroofingin.com/images/nlr-logo.png" } },
  },
  ...(d.faqs.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: d.faqs.map((f) => ({
            "@type": "Question",
            name: f.question,
            acceptedAnswer: { "@type": "Answer", text: f.answer },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={`${d.title} | No Limit Roofing`}
  description={d.metaDescription}
  canonical={canonical}
  ogImage={ogImage}
  preloadImage={d.heroImage}
  schema={schema}
>

  <PageHero
    image={d.heroImage}
    eyebrow="Buying Guide"
    title={d.title}
    lede={d.excerpt}
    crumbs={[{ label: "Guides", href: isPublishedPath("/guides.html") ? "/guides.html" : undefined }, { label: d.title }]}
    ctas={[]}
    meta={`${dateFormatter.format(d.publishDate)} · ${d.author}`}
    trust={false}
  />

  <section class="section">
    <div class="container" style="max-width:760px">
      <div class="max-prose article-body">
        <Fragment set:html={bodyHtml} />
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <SectionHead center eyebrow="Related" title="Related Services & Guides" />
        <div class="chip-row" style="justify-content:center">
          {related.map((link) => (
            <a class="chip" href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.faqs.length > 0 && (
    <section class="section section--fog" aria-labelledby="faq-heading">
      <div class="container" style="max-width:820px">
        <SectionHead center eyebrow="FAQ" title="Common Questions" id="faq-heading" />
        <div>
          {d.faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{f.question}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <PageCta before="Have a roofing" highlight="question like this?" intro="Get a free, no-pressure answer from a CertainTeed factory-certified crew — not another search result." />

</BaseLayout>
