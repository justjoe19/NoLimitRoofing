  <section class="section section--tight" id="free-inspection">
    <div class="container">
      <div class="card p-8" style="max-width:760px;margin:0 auto">
        <div class="section-head center" style="margin-bottom:1.5rem">
          <p class="eyebrow">Free Inspection</p>
          <h2>Your Roof Isn't Going To Fix Itself.</h2>
          <p class="lede">Let's find out what it actually needs.</p>
        </div>

        <form id="quick-inspection-form" name="quick-inspection" method="POST" data-netlify="true" netlify-honeypot="company-website">
          <input type="hidden" name="form-name" value="quick-inspection" />
          <p class="honeypot">
            <label>Don't fill this out if you're human: <input name="company-website" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="form-grid">
            <div class="field">
              <label for="qi-name">Full Name <span class="req">*</span></label>
              <input type="text" id="qi-name" name="name" autocomplete="name" required aria-describedby="qi-name-error" />
              <div class="field-error" id="qi-name-error"></div>
            </div>
            <div class="field">
              <label for="qi-phone">Phone <span class="req">*</span></label>
              <input type="tel" id="qi-phone" name="phone" autocomplete="tel" required aria-describedby="qi-phone-error" />
              <div class="field-error" id="qi-phone-error"></div>
            </div>
            <div class="field">
              <label for="qi-email">Email <span class="req">*</span></label>
              <input type="email" id="qi-email" name="email" autocomplete="email" required aria-describedby="qi-email-error" />
              <div class="field-error" id="qi-email-error"></div>
            </div>
            <div class="field">
              <label for="qi-address">Property Address <span class="req">*</span></label>
              <input type="text" id="qi-address" name="address" autocomplete="street-address" required aria-describedby="qi-address-error" />
              <div class="field-error" id="qi-address-error"></div>
            </div>
            <div class="field full">
              <label for="qi-service">Service Needed</label>
              <select id="qi-service" name="service">
                <option value="Not sure yet">Not sure yet</option>
                <option value="Roof Repair">Roof Repair</option>
                <option value="Roof Replacement">Roof Replacement</option>
                <option value="Storm Damage">Storm Damage</option>
                <option value="Commercial Roofing">Commercial Roofing</option>
                <option value="Roof Inspection">Roof Inspection</option>
              </select>
            </div>
            <div class="field full">
              <label for="qi-message">Message (optional)</label>
              <textarea id="qi-message" name="message" placeholder="Anything else we should know?"></textarea>
            </div>
          </div>
          <div class="form-status" id="quick-inspection-status" role="status"></div>
          <button type="submit" class="btn btn-primary btn-block mt-3">Schedule My Free Roof Inspection</button>
        </form>
      </div>
    </div>
  </section>

