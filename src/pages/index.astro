---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroImage = "/images/hero-craftsman-dusk.webp";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "RoofingContractor",
    name: "No Limit Roofing",
    image: "https://nolimitroofingin.com/images/hero-craftsman-dusk.webp",
    logo: "https://nolimitroofingin.com/images/nlr-logo.png",
    url: "https://nolimitroofingin.com/",
    telephone: "+1-574-360-0525",
    priceRange: "$$",
    description: "Locally owned and trusted roofing contractor serving the Michiana area since 2010. Providing residential and commercial roofing, roof repair, replacements, hail damage repair, and storm damage repair.",
    founder: { "@type": "Person", name: "Jonathan Smith" },
    foundingDate: "2010",
    areaServed: [
      { "@type": "AdministrativeArea", name: "St. Joseph County, IN" },
      { "@type": "AdministrativeArea", name: "LaPorte County, IN" },
      { "@type": "AdministrativeArea", name: "Marshall County, IN" },
      { "@type": "AdministrativeArea", name: "Berrien County, MI" },
      { "@type": "AdministrativeArea", name: "Cass County, MI" },
    ],
    address: [
      { "@type": "PostalAddress", streetAddress: "1821 Clover Rd, Unit 2", addressLocality: "Mishawaka", addressRegion: "IN", postalCode: "46545", addressCountry: "US" },
      { "@type": "PostalAddress", addressLocality: "Plymouth", addressRegion: "IN", addressCountry: "US" },
    ],
    sameAs: [
      "https://www.facebook.com/NoLimitRoofingIN",
      "https://www.linkedin.com/company/no-limit-roofing-indiana",
      "https://www.youtube.com/playlist?list=PLDUZrNECz2Z4Ksgya690qh1jjwAwEqeDd",
    ],
  },
];
---

<BaseLayout
  title="No Limit Roofing | Michiana Roofing Contractor"
  description="More than roofs. We restore peace of mind. Residential, commercial, and storm damage roofing across Northern Indiana and Southwest Michigan. Free inspections."
  canonical="https://nolimitroofingin.com/"
  ogImage="https://nolimitroofingin.com/images/hero-craftsman-dusk.webp"
  ogTitle="No Limit Roofing | More Than Roofs. We Restore Peace of Mind."
  ogDescription="Locally owned and trusted roofing experts serving Michiana. Free roof inspections, storm damage repair, full roof replacements, and commercial roofing."
  preloadImage={heroImage}
  schema={schema}
>

  <!-- SECTION 2: HERO -->
  <section class="hero-mockup" aria-label="Hero">
    <div class="container hero-mockup-inner">
      <div>
        <p class="hero-eyebrow text-xs sm:text-sm font-extrabold uppercase tracking-[0.22em] text-[#d6dbe0] mb-4">
          STORM DAMAGE &bull; INSURANCE CLAIMS &bull; RESIDENTIAL &amp; COMMERCIAL
        </p>
        <h1 class="hero-title text-white font-black uppercase text-3xl sm:text-4xl lg:text-[3.25rem] tracking-tight leading-[1.08]">
          MORE THAN<br />
          <span class="text-accent">ROOFS.</span> WE RESTORE<br />
          PEACE OF MIND.
        </h1>
        <p class="lede mt-5 max-w-[560px] text-[#d6dbe0] text-base sm:text-lg leading-relaxed">
          At No Limit Roofing, we specialize in storm damage repair, roof replacements, and insurance claim support. We handle the process so you can focus on what matters most.
        </p>
        <div class="hero-actions mt-8 flex flex-wrap gap-4 items-center">
          <a class="btn-hero-primary" href="#inspection">
            GET A FREE INSPECTION
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline-block size-4.5" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <a class="btn-hero-outline" href="tel:+15743600525">
            CALL NOW
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <img
          src="/images/hero-storms-hit-callout.webp"
          alt="When Storms Hit... We Build Back Stronger"
          class="hero-script-callout"
          width="400"
          height="327"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 3: TRUST STRIP -->
  <section class="trust-strip-stacked" aria-label="Trust highlights">
    <div class="container trust-strip-stacked-grid">
      <div class="trust-strip-stacked-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-8 shrink-0 text-white" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M12 2v20"/>
          <path d="M4 10h16"/>
          <path d="M4 5.5l8-2.5v7H4z" fill="currentColor" opacity="0.9"/>
          <path d="M12 10h8c0 4.5-3.5 9-8 11.5V10z" fill="currentColor" opacity="0.9"/>
        </svg>
        <span class="label">INSURANCE CLAIM<br />EXPERTS</span>
      </div>

      <div class="trust-strip-stacked-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="size-8 shrink-0 text-white" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="m8 12 3 3 6-6"/>
        </svg>
        <span class="label">HIGH QUALITY<br />MATERIALS</span>
      </div>

      <div class="trust-strip-stacked-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 shrink-0 text-white" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span class="label">EXPERIENCED<br />&amp; TRUSTED</span>
      </div>

      <div class="trust-strip-stacked-item">
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-8 shrink-0 text-white" aria-hidden="true">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
          <path d="M17 4h2v3.5l-2-1.8z" />
        </svg>
        <span class="label">RESIDENTIAL &amp;<br />COMMERCIAL</span>
      </div>

      <div class="trust-strip-stacked-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 shrink-0 text-white" aria-hidden="true">
          <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
          <path d="m11 13-3 6h4l-1 5 5-7h-4l2-4"/>
        </svg>
        <span class="label">24/7 STORM<br />RESPONSE</span>
      </div>
    </div>
  </section>

  <!-- SECTION 4: COMPLETE ROOFING SOLUTIONS -->
  <section class="section" aria-labelledby="complete-solutions-heading">
    <div class="container">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-6 border-b border-mist/40">
        <div>
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-[0.2em] text-[#12161b]">
            OUR SERVICES
          </span>
          <h2 id="complete-solutions-heading" class="text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-[#12161b] mt-1">
            COMPLETE ROOFING SOLUTIONS
          </h2>
          <div class="w-14 h-1 bg-accent mt-2.5"></div>
        </div>
        <p class="max-w-[540px] text-sm sm:text-base text-[#4a5568] leading-relaxed">
          From storm damage to full roof replacements, No Limit Roofing delivers reliable, high-quality craftsmanship for residential and commercial properties.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-3.5 mt-8">
        <!-- CARD 1: HAIL DAMAGE -->
        <div class="service-card-mockup group">
          <div class="service-card-img-wrap">
            <img
              src="/images/service-card-hail-damage.webp"
              alt="Hail damage on asphalt shingles"
              width="400"
              height="400"
              loading="lazy"
            />
          </div>
          <div class="service-card-bottom">
            <span class="service-card-title whitespace-nowrap">HAIL DAMAGE</span>
          </div>
        </div>

        <!-- CARD 2: ROOF INSTALLATIONS -->
        <div class="service-card-mockup group">
          <div class="service-card-img-wrap">
            <img
              src="/images/service-card-roof-installations.webp"
              alt="New architectural shingle roof installation"
              width="400"
              height="400"
              loading="lazy"
            />
          </div>
          <div class="service-card-bottom">
            <span class="service-card-title">ROOF<br />INSTALLATIONS</span>
          </div>
        </div>

        <!-- CARD 3: ROOF REPAIRS -->
        <div class="service-card-mockup group">
          <div class="service-card-img-wrap">
            <img
              src="/images/service-card-roof-repairs.webp"
              alt="Professional roofer performing precise roof repair"
              width="400"
              height="400"
              loading="lazy"
            />
          </div>
          <div class="service-card-bottom">
            <span class="service-card-title whitespace-nowrap">ROOF REPAIRS</span>
          </div>
        </div>

        <!-- CARD 4: STORM DAMAGE -->
        <div class="service-card-mockup group">
          <div class="service-card-img-wrap">
            <img
              src="/images/service-card-storm-damage.webp"
              alt="Storm clouds and lightning over suburban homes"
              width="400"
              height="400"
              loading="lazy"
            />
          </div>
          <div class="service-card-bottom">
            <span class="service-card-title whitespace-nowrap">STORM DAMAGE</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 5: WHY CHOOSE NO LIMIT ROOFING -->
  <section class="why-choose-mockup" aria-labelledby="why-choose-heading">
    <div class="container split items-center gap-12 lg:gap-16">
      <div class="flex flex-col items-center justify-center text-center">
        <img
          src="/images/nlr-logo.webp"
          alt="No Limit Roofing"
          width="420"
          height="232"
          loading="lazy"
          class="max-w-[340px] sm:max-w-[390px] lg:max-w-[430px] w-full drop-shadow-2xl"
        />
        <p class="mt-4 text-xs sm:text-sm font-black uppercase tracking-[0.22em] text-white/90">
          BUILDING A STRONGER TOMORROW
        </p>
      </div>

      <div>
        <h2 id="why-choose-heading" class="text-white font-black uppercase text-2xl sm:text-3xl lg:text-4xl tracking-tight">
          WHY CHOOSE NO LIMIT ROOFING?
        </h2>
        <div class="w-14 h-1 bg-accent mt-2.5 mb-4"></div>
        <p class="text-[#c7cdd3] leading-relaxed text-[1.02rem]">
          We're more than a roofing company — we're a team committed to protecting what matters most. With extensive experience in roofing and insurance claim support and a reputation for integrity, we go above and beyond to deliver exceptional results.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-white/15">
          <div class="why-choose-stat-box">
            <strong>1000+</strong>
            <span>ROOFS COMPLETED</span>
          </div>
          <div class="why-choose-stat-box">
            <strong>GOOGLE</strong>
            <span>HIGHLY RATED</span>
          </div>
          <div class="why-choose-stat-box">
            <strong>FAST</strong>
            <span>CLAIM SUPPORT</span>
          </div>
          <div class="why-choose-stat-box">
            <strong>LOCALLY</strong>
            <span>OWNED &amp; OPERATED</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: WHAT OUR CUSTOMERS SAY -->
  <section class="section section--fog" aria-labelledby="reviews-heading">
    <div class="container">
      <div class="section-head center">
        <h2 id="reviews-heading" class="font-black uppercase tracking-tight">WHAT OUR CUSTOMERS SAY</h2>
        <div class="stars stars-lg justify-center mt-3 text-accent" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
        </div>
      </div>

      <div class="testimonial-carousel" id="testimonial-carousel">
        <button type="button" class="carousel-arrow carousel-prev" aria-label="Previous review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="testimonial-slides">
          <blockquote class="testimonial-slide is-active">
            <p>&ldquo;No Limit Roofing made the entire process so easy. They handled everything with the insurance company and our new roof looks amazing!&rdquo;</p>
            <footer>&mdash; HAPPY HOMEOWNER</footer>
          </blockquote>
          <blockquote class="testimonial-slide">
            <p>&ldquo;They were prompt, accurate, and professional. I will definitely recommend them for your roofing needs.&rdquo;</p>
            <footer>&mdash; K. HALL, SOUTH BEND, IN</footer>
          </blockquote>
          <blockquote class="testimonial-slide">
            <p>&ldquo;Jon gave us stellar customer service and I didn't have to worry!! Highly recommend!!&rdquo;</p>
            <footer>&mdash; L. BAUER, SOUTH BEND, IN</footer>
          </blockquote>
          <blockquote class="testimonial-slide">
            <p>&ldquo;I am very happy with the work that was done and will definitely be recommending him to my friends and family!&rdquo;</p>
            <footer>&mdash; S. WILCOX, SOUTH BEND, IN</footer>
          </blockquote>
          <blockquote class="testimonial-slide">
            <p>&ldquo;Jonathan was very professional and his team moved very quickly to get my new roof completed. Thank you!&rdquo;</p>
            <footer>&mdash; S. ROSADO, MICHIANA</footer>
          </blockquote>
          <blockquote class="testimonial-slide">
            <p>&ldquo;They worked real hard and got the job done. We love the look of the roof and received several compliments from the neighbors.&rdquo;</p>
            <footer>&mdash; D. BEERY, SOUTH BEND, IN</footer>
          </blockquote>
        </div>
        <button type="button" class="carousel-arrow carousel-next" aria-label="Next review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- SECTION 7: PRE-FOOTER CTA / CONTACT FORM -->
  <section id="inspection" class="pre-footer-cta lp-form-section" aria-labelledby="lp-form-h">
    <div class="container split" style="align-items:center">
      <div>
        <p class="text-xs sm:text-sm font-extrabold uppercase tracking-[0.22em] text-white/80 mb-2">
          READY TO GET STARTED?
        </p>
        <h2 id="lp-form-h" class="text-white font-black uppercase text-2xl sm:text-3xl lg:text-4xl leading-[1.1] tracking-tight">
          SCHEDULE YOUR<br />
          <span class="text-accent">FREE ROOF INSPECTION</span> TODAY.
        </h2>
        <p class="mt-4 max-w-[460px] text-[#c7cdd3] leading-relaxed">
          No cost, no obligation. We'll inspect your roof, provide clear documentation, and walk you through every option honestly.
        </p>
        <a href="tel:+15743600525" class="cta-action-row group mt-6">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-6">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span class="font-black uppercase tracking-wider text-[1.05rem]">CALL (574) 360-0525</span>
        </a>
      </div>

      <div class="card p-8 text-ink">
        <div id="lead-sent" class="lp-sent" tabindex="-1" role="status" hidden>
          <h3 class="text-xl font-black uppercase">Request received</h3>
          <p class="mt-2 text-steel">We'll call you shortly to schedule your inspection.</p>
        </div>

        <!-- Same Netlify form + handler as /contact (public/js/main.js); "source" tells ad leads apart. -->
        <form id="lead-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="company-website" data-success-panel="lead-sent">
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="source" value="homepage" />
          <p class="honeypot">
            <label>Don't fill this out if you're human: <input name="company-website" tabindex="-1" autocomplete="off" /></label>
          </p>
          <p class="text-steel">Fields marked <span class="req text-accent-dark">*</span> are required.</p>

          <div class="form-grid mt-3" style="gap:1rem">
            <div class="field full">
              <label for="name">Full Name <span class="req">*</span></label>
              <input type="text" id="name" name="name" autocomplete="name" required aria-describedby="name-error" />
              <div class="field-error" id="name-error"></div>
            </div>
            <div class="field full">
              <label for="phone">Phone <span class="req">*</span></label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" required aria-describedby="phone-error" />
              <div class="field-error" id="phone-error"></div>
            </div>
            <div class="field full">
              <label for="email">Email Address <span class="req">*</span></label>
              <input type="email" id="email" name="email" autocomplete="email" required aria-describedby="email-error" />
              <div class="field-error" id="email-error"></div>
            </div>
            <div class="field full">
              <label for="address">Property Address</label>
              <input type="text" id="address" name="address" autocomplete="street-address" />
            </div>
            <div class="field full">
              <label for="message">Notes</label>
              <textarea id="message" name="message" placeholder="What can we help you with? (optional)"></textarea>
            </div>
          </div>

          <div class="form-status" id="form-status" role="status"></div>
          <button type="submit" class="btn btn-primary btn-block mt-3">SCHEDULE FREE ROOF INSPECTION</button>
          <p class="mt-2 text-steel text-[0.85rem]">By submitting, you agree to be contacted about your request by phone, text or email.</p>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>
