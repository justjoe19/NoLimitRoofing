---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("learningCenter", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const heroImage = "/images/service-roof-inspection-hero.webp";
const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://nolimitroofingin.com/" },
      { "@type": "ListItem", position: 2, name: "Learning Center", item: "https://nolimitroofingin.com/learning-center.html" },
    ],
  },
];
---

<BaseLayout
  title="Roofing Learning Center | No Limit Roofing"
  description="Roof cost guides, repair-vs-replacement advice, storm damage explainers and more — real answers to the questions Michiana homeowners actually ask us."
  canonical="https://nolimitroofingin.com/learning-center.html"
  ogImage="https://nolimitroofingin.com/images/service-roof-inspection.webp"
  preloadImage={heroImage}
  schema={schema}
>

  <section class="hero hero--page" style={`--hero-image:url("${heroImage}")`}>
    <div class="container hero-inner wide">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span class="current">Learning Center</span>
      </nav>
      <p class="eyebrow eyebrow--on-dark mt-3">Learning Center</p>
      <h1>Real Answers, Not A Sales Pitch</h1>
      <p class="lede">Roof costs, repair vs. replacement, storm damage, materials — the questions Michiana homeowners actually ask us, answered plainly.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="articles-heading">
    <div class="container">
      <h2 id="articles-heading" class="visually-hidden">Latest Articles</h2>
      {articles.length === 0 ? (
        <p class="lede text-center">New articles are on the way — check back soon.</p>
      ) : (
        <div class="grid grid-3">
          {articles.map((article) => (
            <article class="card service-card">
              <div class="media"><img src={article.data.heroImage.replace("-hero.webp", ".webp")} alt={article.data.title} width="600" height="440" loading="lazy" /></div>
              <div class="body">
                <p class="text-[0.8rem] font-bold text-steel">{dateFormatter.format(article.data.publishDate)}</p>
                <h3>{article.data.title}</h3>
                <p>{article.data.excerpt}</p>
                <a class="more" href={`/learning-center/${article.id}.html`}>Read more<span class="visually-hidden"> about {article.data.title}</span> <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Still Have Questions?</h2>
          <p>Skip the search — ask a real, GAF-certified crew for free.</p>
        </div>
        <div class="hero-actions" style="margin-top:0">
          <a class="btn bg-white text-accent-dark" href="/contact.html">Get My Free Estimate</a>
          <a class="btn btn-outline-light" href="tel:+15743600525">Call (574) 360-0525</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
