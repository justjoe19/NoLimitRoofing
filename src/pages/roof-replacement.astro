---
import LandingPage from "../components/landing/LandingPage.astro";
import AfterSection from "../components/landing/AfterSection.astro";
import TileStrip from "../components/landing/TileStrip.astro";

const signs = [
  "Shingles that are curling, cracked or missing",
  "Leaks or water spots inside",
  "Granules collecting in the gutters",
  "A roof that's near the end of its life",
  "Storm damage that a repair can't fix",
  "A free, no-obligation estimate",
];
const steps = [
  { t: "Roof Evaluation", b: "A professional look at your roof's condition, at no cost." },
  { t: "Clear Options", b: "Straightforward choices for repair or full replacement." },
  { t: "Detailed Estimate", b: "A written estimate with no pressure and no obligation." },
  { t: "Installation", b: "Professional install with a clean, organized job site." },
  { t: "Cleanup & Walkthrough", b: "We clean up and walk through the finished roof with you." },
];
// TODO(client photos): all six tiles are stand-ins from the site's existing image library.
const tiles = [
  { label: "Quality Systems", img: "/images/completed-roof-shingle-detail.webp", alt: "Close-up of a finished shingle roof" },
  { label: "Professional Install", img: "/images/crew-shingle-install.webp", alt: "Crew installing shingles" },
  { label: "Clean Job Sites", img: "/images/aerial-completed-roof.webp", alt: "Aerial view of a completed roof" },
  { label: "Decking Repair", img: "/images/service-decking.webp", alt: "Roof decking" },
  { label: "Shingle Options", img: "/images/service-shingle-options.webp", alt: "Shingle color and style samples" },
  { label: "Tear-Off & Replace", img: "/images/service-tear-off-replacement.webp", alt: "Old roofing being torn off" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Residential Roof Replacement & Installation",
    serviceType: "Roof Replacement",
    url: "https://nolimitroofingin.com/roof-replacement.html",
    description: "Professional roof replacement and installation services with GAF certified craftsmanship, clean job sites, and financing options in Michiana.",
    provider: {
      "@type": "RoofingContractor",
      name: "No Limit Roofing",
      url: "https://nolimitroofingin.com/",
      telephone: "+1-574-360-0525",
      priceRange: "$$",
      image: "https://nolimitroofingin.com/images/hero-craftsman-dusk.webp",
      logo: "https://nolimitroofingin.com/images/nlr-logo.png",
      address: {
        "@type": "PostalAddress",
        streetAddress: "1911 Clover Rd, Suite 10",
        addressLocality: "Mishawaka",
        addressRegion: "IN",
        postalCode: "46545",
        addressCountry: "US",
      },
    },
    areaServed: [
      { "@type": "AdministrativeArea", name: "St. Joseph County, IN" },
      { "@type": "AdministrativeArea", name: "LaPorte County, IN" },
      { "@type": "AdministrativeArea", name: "Marshall County, IN" },
      { "@type": "AdministrativeArea", name: "Berrien County, MI" },
      { "@type": "AdministrativeArea", name: "Cass County, MI" },
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      name: "Free Roof Replacement Estimate",
      description: "Detailed, straightforward written roof replacement evaluation and estimate with zero pressure and zero obligation.",
    },
  },
];
---

<!-- TODO(client photos): the three card images below are stand-ins from the site's existing library. -->
<LandingPage
  seo={{
    title: "Free Roof Replacement Estimate | No Limit Roofing",
    description: "Need a new roof? Get a free roof replacement estimate from No Limit Roofing. Professional installation, clean job sites. Call (574) 360-0525.",
    canonical: "https://nolimitroofingin.com/roof-replacement.html",
  }}
  schema={schema}
  source="roof-estimate-lp"
  ctaLabel="Get Free Roof Estimate"
  heroImage="/images/new-roof-estimate-hero.webp"
  eyebrow="No Limit Roofing • Installs & Repairs"
  h1Lines={["Need a", "new roof?"]}
  h1Accent
  subhead="Get a free roof replacement estimate from No Limit Roofing."
  body="A new roof is a big investment. We make the process simple: a professional evaluation, straightforward options, and a detailed estimate — no pressure, no obligation."
  primaryCta="Get My Free Estimate"
  callout={{ type: "image", src: "/images/hero-no-pressure-callout.webp", alt: "No pressure. No limits on quality.", width: 400, height: 327 }}
  trust={["Free roof estimates", "Financing available", "Professional installation", "Clean & organized job sites"]}
  bottomServices
  why={{ body: "Locally owned and operated in Michiana since 2010. Licensed, bonded, insured and GAF factory-certified, with professional crews and clean, organized job sites." }}
  form={{
    before: "Get your", highlight: "free roof estimate", after: "today.",
    intro: "No pressure, no obligation. Ask about financing options.",
    notesPlaceholder: "Replacement or repair? Anything we should know (optional)",
    success: "Thank you! We'll reach out within 24 hours to schedule your free estimate.",
  }}
>
  <Fragment slot="after-trust">
    <AfterSection
      eyebrow="Is it time?"
      heading="Is It Time for a New Roof?"
      intro="A new roof is a big investment. We'll evaluate your roof, explain your options clearly, and give you a written estimate, with no pressure and no obligation."
      signs={signs}
      ctaLabel="Get my free estimate"
      processEyebrow="How it works"
      processHeading="Simple Process. Straight Answers."
      processIntro="No surprises, from the first look to the final cleanup."
      steps={steps}
      beforeLabel={["BEFORE", "OLD ROOF"]}
      afterLabel={["AFTER", "NEW ROOF"]}
    />
    <TileStrip
      eyebrow="What you get"
      heading="A Roof Done Right, Start to Finish"
      intro="Quality systems, professional crews, and a job site we leave cleaner than we found it."
      ctaLabel="Get my free estimate"
      tiles={tiles}
    />
  </Fragment>
</LandingPage>
