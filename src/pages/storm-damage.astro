---
import LandingPage from "../components/landing/LandingPage.astro";
import AfterSection from "../components/landing/AfterSection.astro";
import TileStrip from "../components/landing/TileStrip.astro";

const signs = [
  "Missing, cracked or lifted shingles",
  "Hail dents on roof, gutters or siding",
  "Wind damage",
  "Leaks or water spots inside",
  "Damage to flashing, vents or gutters",
  "A free, no-obligation inspection",
];
const steps = [
  { t: "Free Inspection", b: "We inspect and document all damage." },
  { t: "Insurance Claim Help", b: "We meet with your adjuster and advocate for you." },
  { t: "Detailed Estimate", b: "You get a clear, itemized estimate." },
  { t: "Quality Installation", b: "We install your new roof with expert care." },
  { t: "Peace of Mind", b: "Your home is protected for what's next." },
];
// TODO(client photos): Tree and Gutter are placeholders until the client sends photos.
const tiles = [
  { label: "Hail Damage", img: "/images/service-card-hail-damage.webp", alt: "Hail damage on asphalt shingles" },
  { label: "Wind Damage", img: "/images/service-wind-damage.webp", alt: "Wind-damaged shingles" },
  { label: "Tree Damage", img: "/images/service-tree-damage-520.webp", alt: "Tree damage on a roof" },
  { label: "Gutter Damage", img: "/images/service-gutter-damage-520.webp", alt: "Storm-damaged gutter" },
  { label: "Flashing Damage", img: "/images/crew-roofer-chimney-flashing.webp", alt: "Roof flashing at a chimney" },
  { label: "Roof Leaks", img: "/images/storm-emergency-tarp.webp", alt: "Crew tarping a leaking roof" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Storm Damage Roof Inspection & Repair",
    serviceType: "Storm Damage Inspection",
    url: "https://nolimitroofingin.com/storm-damage.html",
    description: "Professional storm damage roof inspections, hail and wind damage documentation, and insurance claim assistance for homeowners in Michiana.",
    provider: {
      "@type": "RoofingContractor",
      name: "No Limit Roofing",
      url: "https://nolimitroofingin.com/",
      telephone: "+1-574-360-0525",
      priceRange: "$$",
      image: "https://nolimitroofingin.com/images/hero-craftsman-dusk.webp",
      logo: "https://nolimitroofingin.com/images/nlr-logo.png",
      address: {
        "@type": "PostalAddress",
        streetAddress: "1911 Clover Rd, Suite 10",
        addressLocality: "Mishawaka",
        addressRegion: "IN",
        postalCode: "46545",
        addressCountry: "US",
      },
    },
    areaServed: [
      { "@type": "AdministrativeArea", name: "St. Joseph County, IN" },
      { "@type": "AdministrativeArea", name: "LaPorte County, IN" },
      { "@type": "AdministrativeArea", name: "Marshall County, IN" },
      { "@type": "AdministrativeArea", name: "Berrien County, MI" },
      { "@type": "AdministrativeArea", name: "Cass County, MI" },
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      name: "Free Storm Damage Roof Inspection",
      description: "Comprehensive multi-point storm damage inspection and photo damage report with zero cost and no obligation.",
    },
  },
];
---

<LandingPage
  seo={{
    title: "Free Storm Damage Roof Inspection | No Limit Roofing",
    description: "Think your roof has storm damage? Get a professional roof inspection and photo report from No Limit Roofing. Call (574) 360-0525.",
    canonical: "https://nolimitroofingin.com/storm-damage.html",
  }}
  schema={schema}
  source="storm-damage-lp"
  ctaLabel="Schedule Free Roof Inspection"
  heroImage="/images/storm-damage-hero.webp"
  eyebrow="No Limit Roofing • Storm Damage"
  h1Lines={["Think your roof", "has storm", "damage?"]}
  h1Accent
  subhead="Get a professional roof inspection & photo report."
  body="Hail, wind and storm damage isn't always obvious from the ground. We inspect it, document it, and explain it honestly."
  primaryCta="Get a Free Inspection"
  callout={{ type: "image", src: "/images/hero-storms-hit-callout-560.webp", alt: "When storms hit… we build back stronger", width: 400, height: 327 }}
  trust={["Free roof inspection", "Photo damage report", "Insurance claim experts", "24/7 storm response"]}
  bottomServices
  why={{ body: "Locally owned and operated in Michiana since 2010. Licensed, bonded, insured and CertainTeed factory-certified, with fast insurance claim support." }}
  form={{
    before: "Schedule your", highlight: "free roof inspection", after: "today.",
    intro: "No cost, no obligation. You'll get a detailed report of exactly what's on your roof.",
    notesPlaceholder: "What did you notice? (optional)",
    success: "Thank you! We'll reach out within 24 hours to schedule your free inspection.",
  }}
>
  <Fragment slot="after-trust">
    <AfterSection
      eyebrow="After the storm"
      heading="Has Your Home Been Hit by a Storm?"
      intro="Even if you don't see damage from the ground, there could be hidden issues. We'll inspect your roof, document everything, and help you with the insurance process, at no cost to you."
      signs={signs}
      ctaLabel="Schedule my free inspection"
      processEyebrow="Our process"
      processHeading="A Stress-Free Storm Recovery"
      processIntro="We handle the hard part so you don't have to."
      steps={steps}
      beforeImg="/images/storm-damage-before-640.webp"
      afterImg="/images/storm-damage-after-640.webp"
      beforeLabel={["BEFORE", "STORM DAMAGE"]}
      afterLabel={["AFTER", "NEW ROOF"]}
    />
    <TileStrip
      eyebrow="Common storm damage"
      heading="We Fix All Types of Storm Damage"
      intro="From hail to high winds, we've seen it all. Our team knows what to look for and how to restore your home the right way."
      ctaLabel="Get my free inspection"
      tiles={tiles}
    />
  </Fragment>
</LandingPage>
