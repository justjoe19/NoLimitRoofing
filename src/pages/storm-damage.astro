---
import LandingPage from "../components/landing/LandingPage.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Storm Damage Roof Inspection & Repair",
    serviceType: "Storm Damage Inspection",
    url: "https://nolimitroofingin.com/storm-damage.html",
    description: "Professional storm damage roof inspections, hail and wind damage documentation, and insurance claim assistance for homeowners in Michiana.",
    provider: {
      "@type": "RoofingContractor",
      name: "No Limit Roofing",
      url: "https://nolimitroofingin.com/",
      telephone: "+1-574-360-0525",
      priceRange: "$$",
      image: "https://nolimitroofingin.com/images/hero-craftsman-dusk.webp",
      logo: "https://nolimitroofingin.com/images/nlr-logo.png",
      address: {
        "@type": "PostalAddress",
        streetAddress: "1911 Clover Rd, Suite 10",
        addressLocality: "Mishawaka",
        addressRegion: "IN",
        postalCode: "46545",
        addressCountry: "US",
      },
    },
    areaServed: [
      { "@type": "AdministrativeArea", name: "St. Joseph County, IN" },
      { "@type": "AdministrativeArea", name: "LaPorte County, IN" },
      { "@type": "AdministrativeArea", name: "Marshall County, IN" },
      { "@type": "AdministrativeArea", name: "Berrien County, MI" },
      { "@type": "AdministrativeArea", name: "Cass County, MI" },
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      name: "Free Storm Damage Roof Inspection",
      description: "Comprehensive multi-point storm damage inspection and photo damage report with zero cost and no obligation.",
    },
  },
];
---

<LandingPage
  seo={{
    title: "Free Storm Damage Roof Inspection | No Limit Roofing",
    description: "Think your roof has storm damage? Get a professional roof inspection and photo report from No Limit Roofing. Call (574) 360-0525.",
    canonical: "https://nolimitroofingin.com/storm-damage.html",
  }}
  schema={schema}
  source="storm-damage-lp"
  ctaLabel="Schedule Free Roof Inspection"
  heroImage="/images/storm-damage-hero.webp"
  eyebrow="No Limit Roofing • Storm Damage"
  h1Lines={["Think your roof", "has storm", "damage?"]}
  h1Accent
  subhead="Get a professional roof inspection & photo report."
  body="Hail, wind and storm damage isn't always obvious from the ground. We inspect it, document it, and explain it honestly."
  primaryCta="Get a Free Inspection"
  callout={{ type: "image", src: "/images/hero-storms-hit-callout.webp", alt: "When storms hit… we build back stronger", width: 400, height: 327 }}
  trust={["Free roof inspection", "Photo damage report", "Insurance claim experts", "24/7 storm response"]}
  cards={{
    eyebrow: "What we look for",
    title: "Damage you can't see from the ground",
    intro: "Most storm damage only shows up up close. Here's what our inspection covers.",
    items: [
      { img: "/images/hail-damage.webp", title: "Hail damage", body: "Bruised or cracked shingles, granule loss and dented soft metals." },
      { img: "/images/service-wind-damage.webp", title: "Wind damage", body: "Creased, lifted or loosened shingles with broken seals — where leaks start." },
      { img: "/images/storm-emergency-tarp.webp", title: "Active leaks", body: "Visible damage or water coming in right now gets priority." },
    ],
  }}
  process={{
    eyebrow: "The No Limit Roof Check™",
    title: "We inspect it. We photograph it.",
    highlight: "You decide.",
    steps: [
      { title: "We inspect", body: "Shingles, flashing, vents, ridges, valleys and visible decking." },
      { title: "We photograph", body: "Clear documentation, useful whether you file a claim or not." },
      { title: "We explain", body: "A plain-language rundown. No upsell, no pressure." },
      { title: "You decide", body: "Repair, replace, or do nothing — your call." },
    ],
  }}
  why={{ body: "Locally owned and operated in Michiana since 2010. Licensed, bonded, insured and GAF factory-certified, with fast insurance claim support." }}
  form={{
    before: "Schedule your", highlight: "free roof inspection", after: "today.",
    intro: "No cost, no obligation. You'll get a detailed report of exactly what's on your roof.",
    notesPlaceholder: "What did you notice? (optional)",
    success: "Thank you! We'll reach out within 15–30 minutes during business hours (Mon–Fri, 8am–6pm) to schedule your free inspection.",
  }}
/>
